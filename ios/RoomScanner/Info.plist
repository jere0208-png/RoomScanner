<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- L'APPUI LONG SUR L'ICONE : le meme raccourci que la phrase de Siri.
	     Deux chemins, une seule demande — voir AppDelegate.swift. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>nouveau-releve</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Nouveau relevé</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Scanner une pièce</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCapturePhoto</string>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>EchoPlan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- METRO, EN DEBUG SEULEMENT : la phase « Local networking : Debug only »
		     du projet retire cette clé du paquet hors Debug (relevé App Store :
		     un reste du modèle de départ dans le build de production). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>La caméra sert à scanner vos pièces en 3D, à prendre des photos de repérage sur le plan et à photographier vos plans papier.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Pour lire les mesures de votre télémètre laser (Leica DISTO) et les reporter directement sur le plan.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>EchoPlan enregistre vos photos de repérage dans votre photothèque, pour qu’elles restent sur votre téléphone même si vous réinstallez l’application.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>EchoPlan range vos photos de repérage dans un album « EchoPlan » et les relit pour les retrouver sur vos plans, même après une réinstallation. Il ne parcourt jamais vos autres photos.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
